# Local, isolated synthetic demo. No provider key or database is required.
# Copy to .env at the repository root. Never commit .env or real credentials.
# Leave NODE_ENV unset here so Vite can produce a production build.
HOST=0.0.0.0
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,http://127.0.0.1:5173,http://127.0.0.1:3001
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Optional persistent API state. Leave unset for process-local demo storage.
# Use your provider's TLS-enabled connection URL; never disable TLS validation.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Browser setting: public API origin, WITHOUT /api or trailing slash.
# Leave empty locally: Vite proxies /api to the API. This is public build-time data.
VITE_API_BASE_URL=

# Server-only Qloo adapter. No explicit environment key means gate UNVERIFIED.
# Keep the real key outside this repository, in the API's private environment.
# The app does not adopt credentials from a separate qloo setup session.
# QLOO_API_KEY=
QLOO_TRANSPORT=harness
# Explicit compatibility option: QLOO_TRANSPORT=direct-http. No auto-fallback.
# Required event origin. Upstream standalone harness defaults to production.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_CACHE_TTL_MS=900000
QLOO_TIMEOUT_MS=10000
# Total retry-wait budget, not a provider quota; respect longer Retry-After by stopping.
QLOO_RETRY_BUDGET_MS=5000
# QLOO_PROBE_OUTPUT=reports/qloo-probe.json

# Optional LLM-only comparison. Never use VITE_ for any credential.
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=

# Optional pnpm seed API origin. This does not seed the browser's session.
# RR_API_URL=http://localhost:3001

# Cross-site hosted web/API (e.g. pages.dev + onrender.com):
# ALLOWED_ORIGINS=https://YOUR-WEB-HOST
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# VITE_API_BASE_URL=https://YOUR-API-HOST
# Third-party cookie blocking can still prevent sessions; prefer same-site hosts.
